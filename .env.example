# ==============================================================================
# NEXUS Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables for your deployment environment.

# Server Bindings
HOST=127.0.0.1
PORT=8000

# CORS Origins (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Session Management
MAX_SESSIONS=100
SESSION_TTL_SECONDS=86400

# Results & Artifacts Directory
RESULTS_DIR=results
